<Window x:Class="Radiodex.EditStationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Radiodex.Services"
        Title="{Binding Source={x:Static s:Loc.I}, Path=[EditTitle]}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <StackPanel Margin="28,24,28,24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="128" Height="128" CornerRadius="14" Background="#2B3140" ClipToBounds="True" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="CoverInitials" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="Cover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource BaseButton}" Height="40" Tag="8" HorizontalAlignment="Left" Click="OnPickCover"
                        Content="{Binding Source={x:Static s:Loc.I}, Path=[ChooseCover]}" />
                <Button x:Name="ResetCoverButton" Style="{StaticResource GhostButton}" Height="36" MinHeight="36" Tag="8" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="2,0"
                        Click="OnResetCover" Content="{Binding Source={x:Static s:Loc.I}, Path=[ResetCover]}" />
                <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[CoverHint]}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[StationNameLabel]}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,22,0,8" />
        <TextBox x:Name="NameBox" Style="{StaticResource Field}" KeyDown="OnNameKeyDown"
                 AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[StationNameLabel]}" />
        <Button x:Name="ResetNameButton" Style="{StaticResource GhostButton}" Height="32" MinHeight="32" Tag="8" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="2,0" FontSize="12"
                Click="OnResetName" />
        <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[NameHint]}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource BaseButton}" Height="44" Tag="8" Click="OnCancel" Content="{Binding Source={x:Static s:Loc.I}, Path=[Cancel]}" />
            <Button Style="{StaticResource PrimaryButton}" Height="44" Tag="8" Margin="10,0,0,0" Padding="22,0" Click="OnSave" IsDefault="True"
                    Content="{Binding Source={x:Static s:Loc.I}, Path=[Save]}" />
        </StackPanel>
    </StackPanel>
</Window>
