<Window x:Class="Radiodex.LikedSongsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Radiodex.Services"
        Title="{Binding Source={x:Static s:Loc.I}, Path=[LikedSongs]}"
        Width="820" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <DockPanel Margin="28,22,28,22">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Data="{StaticResource IcoHeart}" Fill="{StaticResource Heart}" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[LikedSongs]}" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource Muted}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="44" Tag="8" Padding="18,0" Click="OnExport"
                    Content="{Binding Source={x:Static s:Loc.I}, Path=[ExportCsv]}" />
        </Grid>

        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Field}" Margin="0,0,0,14" TextChanged="OnSearchChanged"
                 AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[SearchSongs]}" />

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="{Binding Source={x:Static s:Loc.I}, Path=[NoLikedSongs]}" FontSize="14"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed" />

        <ListBox x:Name="Songs" Style="{StaticResource PlainList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Sidebar}" CornerRadius="8" Padding="12,6" Margin="0,0,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StationName}" FontSize="13" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}" MinHeight="34" Height="34" Padding="8,0" Tag="6" FontSize="13" FontWeight="SemiBold"
                                        Content="YouTube" Click="OnYouTube" />
                                <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Accent}" MinHeight="34" Height="34" Padding="8,0" Tag="6" FontSize="13" FontWeight="SemiBold"
                                        Content="Spotify" Click="OnSpotify" />
                            </StackPanel>
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Width="38" Height="38" MinHeight="38" Padding="0" Tag="19" Click="OnUnlike"
                                    ToolTip="{Binding Source={x:Static s:Loc.I}, Path=[Unlike]}" AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[Unlike]}">
                                <Path Data="{StaticResource IcoHeart}" Fill="{StaticResource Heart}" Width="17" Height="17" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
