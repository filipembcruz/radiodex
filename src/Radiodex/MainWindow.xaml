<Window x:Class="Radiodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Radiodex.Services"
        Title="Radiodex"
        Icon="/Assets/radiodex.ico"
        Width="1120" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16" LastChildFill="True">

                <Grid DockPanel.Dock="Top" Margin="2,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/radiodex.png" RenderOptions.BitmapScalingMode="HighQuality" Width="26" Height="26" />
                        <TextBlock Text="Radiodex" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{Binding Source={x:Static s:Loc.I}, Path=[Language]}">
                        <Button x:Name="LangPt" Content="PT" Style="{StaticResource GhostButton}" MinHeight="30" Height="30" Padding="10,0" Tag="6" FontSize="12" Click="OnLangPt" />
                        <Button x:Name="LangEn" Content="EN" Style="{StaticResource GhostButton}" MinHeight="30" Height="30" Padding="10,0" Tag="6" FontSize="12" Click="OnLangEn" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" Text="{Binding Source={x:Static s:Loc.I}, Path=[AddStation]}" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddBox" Style="{StaticResource Field}" Tag="{Binding Source={x:Static s:Loc.I}, Path=[SearchOrPaste]}" KeyDown="OnAddKeyDown"
                             AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[SearchOrPaste]}" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Width="44" Height="44" Padding="0" Tag="8" Margin="8,0,0,0" Click="OnAddClick"
                            ToolTip="{Binding Source={x:Static s:Loc.I}, Path=[AddStation]}" AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[AddStation]}">
                        <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Icon}" StrokeThickness="2.6" />
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Background="{StaticResource Bg}" CornerRadius="10" Padding="4" Margin="0,0,0,12">
                    <UniformGrid Columns="2">
                        <Button x:Name="TabAll" Style="{StaticResource GhostButton}" MinHeight="36" Height="36" Tag="7" FontWeight="SemiBold" FontSize="13" Click="OnTabAll" />
                        <Button x:Name="TabFav" Style="{StaticResource GhostButton}" MinHeight="36" Height="36" Tag="7" FontWeight="SemiBold" FontSize="13" Click="OnTabFav" />
                    </UniformGrid>
                </Border>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource BaseButton}" Height="48" Tag="10" Margin="0,12,0,0" Padding="12,0"
                        HorizontalContentAlignment="Stretch" Click="OnLikedSongs">
                    <Grid Width="276">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IcoHeart}" Fill="{StaticResource Heart}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[LikedSongs]}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LikedCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13" />
                    </Grid>
                </Button>

                <Grid>
                    <ListBox x:Name="StationList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource StationItem}"
                             SelectionChanged="OnStationSelected" KeyDown="OnListKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Source={x:Static s:Loc.I}, Path=[EditStation]}" Click="OnEditStation" />
                                <MenuItem Header="{Binding Source={x:Static s:Loc.I}, Path=[Remove]}" Click="OnRemoveStation" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="9" Background="#2B3140" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding LogoUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Path Grid.Column="2" Data="{StaticResource IcoStar}" Fill="{StaticResource Accent}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                                          Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyList" VerticalAlignment="Top" Margin="6,12,6,0">
                        <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[EmptyTitle]}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[EmptyHint]}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Now playing ============ -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <Image Source="/Assets/radiodex.png" RenderOptions.BitmapScalingMode="HighQuality" Width="96" Height="96" />
                <TextBlock Text="Radiodex" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[AppTagline]}" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer x:Name="NowPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,28">

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="148" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="148" Height="148" CornerRadius="16" Background="#2B3140" ClipToBounds="True" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <TextBlock x:Name="BigInitials" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="BigLogo" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="LiveBadge" CornerRadius="10" Padding="9,3" Background="{StaticResource LiveSoft}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource Live}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LiveText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Live}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="FormatText" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MaxWidth="520" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StationName" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Width="40" Height="40" MinHeight="40" Padding="0" Tag="20" Margin="8,2,0,0"
                                        Foreground="{StaticResource Text2}" Click="OnEditStation" VerticalAlignment="Center"
                                        ToolTip="{Binding Source={x:Static s:Loc.I}, Path=[EditStation]}" AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[EditStation]}">
                                    <Path Data="{StaticResource IcoEdit}" Style="{StaticResource Icon}" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="StationPlace" FontSize="14" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[NowPlaying]}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,14,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" MaxWidth="460">
                                    <TextBlock x:Name="SongTitle" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SongArtist" FontSize="14" Foreground="{StaticResource Text2}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="LikeButton" Grid.Column="1" Style="{StaticResource BaseButton}" Height="40" Margin="14,0,0,0" HorizontalAlignment="Left" Click="OnLikeSong">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="LikeIcon" Data="{StaticResource IcoHeart}" Style="{StaticResource Icon}" StrokeThickness="1.8" />
                                        <TextBlock x:Name="LikeText" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Controls -->
                    <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="60" Height="60" Padding="0" Tag="30" Click="OnPlayPause">
                                <Path x:Name="PlayIcon" Data="{StaticResource IcoPlay}" Fill="{StaticResource OnAccent}" Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="RecButton" Grid.Column="1" Style="{StaticResource BaseButton}" Height="44" Margin="12,0,0,0" Tag="22" Click="OnRecord">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="RecDot" Width="12" Height="12" CornerRadius="6" Background="{StaticResource Rec}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecText" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="FavButton" Grid.Column="2" Style="{StaticResource BaseButton}" Width="44" Height="44" Padding="0" Margin="12,0,0,0" Tag="22" Click="OnFavorite">
                                <Path x:Name="FavIcon" Data="{StaticResource IcoStar}" Style="{StaticResource Icon}" StrokeThickness="1.8" />
                            </Button>
                            <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource BaseButton}" Height="44" Margin="12,0,0,0" Tag="22" Click="OnRefresh">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoRefresh}" Style="{StaticResource Icon}" />
                                    <TextBlock x:Name="RefreshText" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IcoVolume}" Stroke="{StaticResource Text2}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
                                <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="130" Margin="10,0,8,0" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"
                                        AutomationProperties.Name="{Binding Source={x:Static s:Loc.I}, Path=[Volume]}" />
                                <TextBlock x:Name="VolumeText" Width="40" FontSize="13" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stream + recordings -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[StreamLink]}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBox x:Name="StreamUrl" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text2}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="-2,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse x:Name="LinkDot" Width="8" Height="8" Fill="{StaticResource Live}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LinkStatus" FontSize="13" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[Recordings]}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" MinHeight="26" Height="26" Padding="6,0" Tag="6" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,-4,-6,0" Click="OnOpenFolder"
                                            Content="{Binding Source={x:Static s:Loc.I}, Path=[OpenFolder]}" />
                                </Grid>
                                <TextBlock x:Name="LastRecording" FontSize="13" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[RecordingsHint]}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- History -->
                    <TextBlock Text="{Binding Source={x:Static s:Loc.I}, Path=[RecentlyPlayed]}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,20,0,6" />
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="4,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LocalTime, StringFormat=HH:mm}" Width="52" Foreground="{StaticResource Muted}" FontSize="14" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" FontSize="14" Margin="12,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoHistory" Text="{Binding Source={x:Static s:Loc.I}, Path=[NoSongInfo]}" FontSize="13" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
